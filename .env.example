# OpenRouter — portfolio chat (DeepSeek via OpenRouter)
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=deepseek/deepseek-chat

# Groq — hero voice agent (Whisper STT + Orpheus TTS)
GROQ_API_KEY=your_groq_api_key_here
# STT model — default whisper-large-v3-turbo (fast). Alternatives: whisper-large-v3 (more accurate, slower), distil-whisper-large-v3-en (English-only)
GROQ_STT_MODEL=whisper-large-v3-turbo
# Optional — Whisper prompt for names/commands (max ~224 tokens). Leave unset for built-in portfolio vocabulary.
# GROQ_STT_PROMPT=Portfolio voice assistant. Nahom Tesfaye, schedule, call, terminate, Next.js, React.
GROQ_TTS_MODEL=canopylabs/orpheus-v1-english
# Orpheus male US voices — austin (conversational, default), troy, daniel
# No [confidently] tags — Groq sounds most human with plain text
GROQ_TTS_VOICE=austin

# Optional — used for OpenRouter HTTP-Referer header
NEXT_PUBLIC_SITE_URL=https://nahom-portfolio.vercel.app

# Optional — contact form (voice scheduling uses the same Formspree inbox)
FORMSPREE_FORM_ID=mjgpgqjd
